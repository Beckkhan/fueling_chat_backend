# ── Databases (local Docker postgres:15-alpine; port 25432 mirrors stage) ──
DB_HOST=localhost
DB_PORT=25432
DB_USER=postgres
DB_PASSWORD=<DB_PASSWORD>
FUELING_DB_URL=jdbc:postgresql://localhost:25432/fueling
GAS_STATION_DB_URL=jdbc:postgresql://localhost:25432/gas_station
PAYMENT_DB_URL=jdbc:postgresql://localhost:25432/payment
VENDORS_DB_URL=jdbc:postgresql://localhost:25432/vendors

# ── LLM providers ──
DEEPSEEK_API_KEY=<DEEPSEEK_API_KEY>
DEEPSEEK_MODEL=<DEEPSEEK_MODEL>
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=<OLLAMA_MODEL>

# ── Koog framework (pinned, D-16) ──
KOOG_VERSION=1.3.0

# ── Dialog history (D-1, D-11) ──
DIALOG_HISTORY_FILE=data/dialog-history.jsonl
HISTORY_LIMIT=20
